{
  "name": "draw2quote-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Empaquetado de escritorio (Electron) de Draw2Quote. Separado del package.json raíz para que la versión web no descargue Electron.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron ..",
    "build:win": "electron-builder --config electron-builder.yml --win --publish never",
    "build:linux": "electron-builder --config electron-builder.yml --linux --publish never",
    "build:mac": "electron-builder --config electron-builder.yml --mac --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.0.0"
  }
}
